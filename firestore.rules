// Simple Games rules — friend request missing-document fix v2
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(members) { return signedIn() && request.auth.uid in members; }
    function otherMember(members) { return members[0] == request.auth.uid ? members[1] : members[0]; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      // Each feature has its own update path so accounts created by older
      // versions do not need fields that did not exist yet.
      allow update: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["avatarImage", "bannerImage", "bio", "statusText", "displayName", "displayNameChangedAt"])
          && request.resource.data.get("bannerImage", "") is string
          && request.resource.data.get("bannerImage", "").size() <= 180000
          && request.resource.data.get("avatarImage", "") is string
          && request.resource.data.get("avatarImage", "").size() <= 180000
          && request.resource.data.get("bio", "") is string
          && request.resource.data.get("bio", "").size() <= 160
          && request.resource.data.get("statusText", "") is string
          && request.resource.data.get("statusText", "").size() <= 60
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["displayName", "displayNameChangedAt"])
            || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 30
              && request.resource.data.displayNameChangedAt == request.time
              && (!("displayNameChangedAt" in resource.data)
                || request.time > resource.data.displayNameChangedAt + duration.value(24, "h")))))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "lastActive", "currentGame"])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["messageSound", "doNotDisturb", "hideOnline", "privateActivity", "pinnedFriends"])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["preferences"])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stats"])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["username", "usernameLower", "usernameChangedAt"])
          && request.resource.data.username is string
          && request.resource.data.username.size() >= 3
          && request.resource.data.username.size() <= 20
          && request.resource.data.usernameLower == request.resource.data.username.lower()
          && request.resource.data.usernameChangedAt == request.time
          && (!("usernameChangedAt" in resource.data)
            || request.time > resource.data.usernameChangedAt + duration.value(30, "d"))
          && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid)
      );
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/usernames/$(name))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20;
      allow update: if signedIn()
        && !exists(/databases/$(database)/documents/users/$(resource.data.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      // Friend-request creation checks both possible request IDs first. A
      // signed-in user must be allowed to get a missing document; otherwise
      // Firestore returns "insufficient permissions" instead of "not found".
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == "pending"
        && requestId == request.auth.uid + "_" + request.resource.data.toUid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + "_" + request.resource.data.toUid))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.toUid + "_" + request.auth.uid));
      allow update: if signedIn() && (
        (resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"])
          && request.resource.data.status in ["accepted", "declined"])
        || (resource.data.fromUid == request.auth.uid
          && resource.data.status == "declined"
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "createdAt", "respondedAt"]))
      );
    }

    match /friendships/{friendshipId} {
      // The sender checks this exact document before creating a request.
      // Permit signed-in users to get one friendship document so a missing
      // friendship returns "not found" instead of a permission error.
      allow get: if signedIn();
      allow list: if isMember(resource.data.members);
      allow delete: if isMember(resource.data.members);
      allow create: if isMember(request.resource.data.members)
        && request.resource.data.members.size() == 2
        && (friendshipId == request.resource.data.members[0] + "_" + request.resource.data.members[1]
          || friendshipId == request.resource.data.members[1] + "_" + request.resource.data.members[0])
        && getAfter(/databases/$(database)/documents/friendRequests/$(otherMember(request.resource.data.members) + "_" + request.auth.uid)).data.status == "accepted";
    }

    match /chats/{chatId} {
      allow read: if isMember(resource.data.members);
      allow create: if isMember(request.resource.data.members)
        && request.resource.data.members.size() == 2
        && exists(/databases/$(database)/documents/friendships/$(chatId));
      allow update: if isMember(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size()
        && request.resource.data.members.hasAll(resource.data.members)
        && resource.data.members.hasAll(request.resource.data.members)
        && exists(/databases/$(database)/documents/friendships/$(chatId));

      match /messages/{messageId} {
        // A new conversation has no chat document yet. Friendship is the
        // source of truth, so friends can attach the live listener immediately.
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/friendships/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.members;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && (request.resource.data.text.size() > 0
            || (request.resource.data.get("attachment", {}).get("dataUrl", "") is string
              && request.resource.data.get("attachment", {}).get("dataUrl", "").size() <= 260000
              && request.resource.data.get("attachment", {}).get("type", "") in ["image/png", "image/jpeg", "image/webp", "image/gif"]))
          && exists(/databases/$(database)/documents/friendships/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.members;
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid
          && isMember(get(/databases/$(database)/documents/chats/$(chatId)).data.members);
        allow update: if signedIn() && isMember(get(/databases/$(database)/documents/chats/$(chatId)).data.members) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            && request.resource.data.reactions.diff(resource.data.get("reactions", {})).affectedKeys().hasOnly([request.auth.uid]))
          || (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "editedAt"])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 500)
        );
      }
    }

    match /groupChats/{groupId} {
      allow read: if isMember(resource.data.members);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 8
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          request.resource.data.members == resource.data.members
          || (request.auth.uid == resource.data.ownerUid
            && resource.data.ownerUid in request.resource.data.members
            && request.resource.data.members.size() >= 2
            && request.resource.data.members.size() <= 8)
          || (request.auth.uid != resource.data.ownerUid
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.hasOnly(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1)
        );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isMember(get(/databases/$(database)/documents/groupChats/$(groupId)).data.members);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && (request.resource.data.text.size() > 0
            || (request.resource.data.get("attachment", {}).get("dataUrl", "") is string
              && request.resource.data.get("attachment", {}).get("dataUrl", "").size() <= 260000
              && request.resource.data.get("attachment", {}).get("type", "") in ["image/png", "image/jpeg", "image/webp", "image/gif"]))
          && isMember(get(/databases/$(database)/documents/groupChats/$(groupId)).data.members);
        allow update: if signedIn() && isMember(get(/databases/$(database)/documents/groupChats/$(groupId)).data.members) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            && request.resource.data.reactions.diff(resource.data.get("reactions", {})).affectedKeys().hasOnly([request.auth.uid]))
          || (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "editedAt"])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 500)
        );
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid
          && isMember(get(/databases/$(database)/documents/groupChats/$(groupId)).data.members);
      }
    }

    match /serverInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && inviteId == request.resource.data.serverId + "_" + request.resource.data.toUid
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/servers/$(request.resource.data.serverId)).data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + "_" + request.resource.data.toUid))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.toUid + "_" + request.auth.uid));
      allow update: if signedIn() && (
        (resource.data.toUid == request.auth.uid && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"])
          && request.resource.data.status in ["accepted", "declined"] && request.resource.data.respondedAt == request.time)
        || (resource.data.fromUid == request.auth.uid && resource.data.status == "declined"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "createdAt"])
          && request.resource.data.status == "pending" && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/servers/$(resource.data.serverId)).data.ownerUid == request.auth.uid));
    }
    match /servers/{serverId} {
      function invited() { return signedIn() && exists(/databases/$(database)/documents/serverInvites/$(serverId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/serverInvites/$(serverId + "_" + request.auth.uid)).data.status == "pending"; }
      function server() { return get(/databases/$(database)/documents/servers/$(serverId)).data; }
      function member(s) { return signedIn() && request.auth.uid in s.members && !(request.auth.uid in s.get("banned", [])); }
      function owner(s) { return signedIn() && request.auth.uid == s.ownerUid; }
      function role(s) { return s.get("memberRoles", {}).get(request.auth.uid, "member"); }
      function roleConfig(s) { return s.get("rolePermissions", {}).get(role(s), {}); }
      function moderator(s) { return owner(s) || (member(s) && roleConfig(s).get("manageMessages", false) == true); }
      function channelConfig(s, channel) { return s.get("channelSettings", {}).get(channel, {}); }
      function channelRead(s, channel) {
        return member(s) && channel in s.channels && (owner(s)
          || channelConfig(s, channel).get("private", channelConfig(s, channel).get("roles", []).size() > 0) == false
          || role(s) in channelConfig(s, channel).get("roles", [])
          || request.auth.uid in channelConfig(s, channel).get("members", []));
      }
      function channelSend(s, channel) {
        return channelRead(s, channel) && (owner(s) || roleConfig(s).get("sendMessages", true) == true)
          && (owner(s) || s.get("timeouts", {}).get(request.auth.uid, request.time) <= request.time)
          && (channelConfig(s, channel).get("locked", false) == false || moderator(s))
          && (owner(s) || channelConfig(s, channel).get("restrictSend", false) == false
            || role(s) in channelConfig(s, channel).get("sendRoles", [])
            || request.auth.uid in channelConfig(s, channel).get("sendMembers", []));
      }
      function validServer(s) {
        return s.ownerUid in s.members && s.members is list && s.members.size() >= 1 && s.members.size() <= 50
          && s.get("iconImage", "") is string && s.get("iconImage", "").size() <= 180000
          && s.get("bannerImage", "") is string && s.get("bannerImage", "").size() <= 180000
          && s.name is string && s.name.size() > 0 && s.name.size() <= 32
          && s.channels is list && s.channels.size() >= 1 && s.channels.size() <= 30;
      }
      function commandAllowed(s, c) {
        return channelRead(s, c.channel)
          && s.get("timeouts", {}).get(request.auth.uid, request.time) <= request.time
          && role(s) in channelConfig(s, c.channel).get("commandRoles", {}).get(c.name, []);
      }
      function commandTarget(s, c) {
        return c.target is string && c.target != request.auth.uid && c.target != s.ownerUid
          && roleConfig(s).get("rank", 0) > s.get("rolePermissions", {}).get(s.get("memberRoles", {}).get(c.target, "member"), {}).get("rank", 0);
      }
      function commandKick(s, n, c) {
        return c.name == "kick" && c.target in s.members
          && n.diff(s).affectedKeys().hasOnly(["members", "updatedAt", "lastCommand"])
          && n.members == s.members.removeAll([c.target]);
      }
      function commandBan(s, n, c) {
        return c.name == "ban" && c.target in s.members
          && n.diff(s).affectedKeys().hasOnly(["members", "banned", "updatedAt", "lastCommand"])
          && n.members == s.members.removeAll([c.target])
          && n.banned.toSet() == s.get("banned", []).toSet().union([c.target].toSet())
          && n.banned.size() == n.banned.toSet().size();
      }
      function commandUnban(s, n, c) {
        return c.name == "unban" && c.target in s.get("banned", [])
          && n.diff(s).affectedKeys().hasOnly(["banned", "updatedAt", "lastCommand"])
          && n.banned == s.get("banned", []).removeAll([c.target]);
      }
      function commandTimeout(s, n, c) {
        return c.name in ["timeout", "untimeout"] && c.target in s.members
          && n.diff(s).affectedKeys().hasOnly(["timeouts", "updatedAt", "lastCommand"])
          && n.timeouts.diff(s.get("timeouts", {})).affectedKeys().hasOnly([c.target])
          && n.timeouts[c.target] is timestamp
          && (c.name == "untimeout" ? n.timeouts[c.target] <= request.time
            : (n.timeouts[c.target] > request.time && n.timeouts[c.target] <= request.time + duration.value(7, "d")));
      }
      function commandLock(s, n, c) {
        return c.name in ["lock", "unlock"] && c.target == ""
          && n.diff(s).affectedKeys().hasOnly(["channelSettings", "updatedAt", "lastCommand"])
          && n.channelSettings.diff(s.get("channelSettings", {})).affectedKeys().hasOnly([c.channel])
          && channelConfig(n, c.channel).diff(channelConfig(s, c.channel)).affectedKeys().hasOnly(["locked"])
          && channelConfig(n, c.channel).locked == (c.name == "lock");
      }
      function commandUpdate(s, n) {
        let c = n.get("lastCommand", {});
        return c.keys().hasAll(["name", "channel", "target", "by", "at"])
          && c.keys().hasOnly(["name", "channel", "target", "by", "at"])
          && c.by == request.auth.uid && c.at == request.time && n.updatedAt == request.time
          && commandAllowed(s, c)
          && (commandLock(s, n, c) || (commandTarget(s, c)
            && (commandKick(s, n, c) || commandBan(s, n, c) || commandUnban(s, n, c) || commandTimeout(s, n, c))));
      }
      allow get: if resource.data.get("isPublic", false) == true || member(resource.data) || invited();
      allow list: if resource.data.get("isPublic", false) == true || member(resource.data);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && validServer(request.resource.data);
      allow update: if signedIn() && validServer(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid && (
          owner(resource.data)
          || commandUpdate(resource.data, request.resource.data)
          || (invited() && !(request.auth.uid in resource.data.members)
            && !(request.auth.uid in resource.data.get("banned", []))
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "memberRoles", "updatedAt"])
            && request.resource.data.memberRoles.diff(resource.data.get("memberRoles", {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.memberRoles[request.auth.uid] == "member"
            && getAfter(/databases/$(database)/documents/serverInvites/$(serverId + "_" + request.auth.uid)).data.status == "accepted")
          || (member(resource.data) && request.auth.uid != resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "updatedAt"])
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.hasOnly(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1)
          || (resource.data.get("isPublic", false) == true
            && !(request.auth.uid in resource.data.get("banned", []))
            && !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "memberRoles", "updatedAt"])
            && request.resource.data.memberRoles.diff(resource.data.get("memberRoles", {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.memberRoles[request.auth.uid] == "member")
        );
      allow delete: if owner(resource.data);
      match /messages/{messageId} {
        allow read: if channelRead(server(), resource.data.channel);
        allow create: if channelSend(server(), request.resource.data.channel)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 30
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if channelSend(server(), resource.data.channel)
          && (owner(server()) || roleConfig(server()).get("editOwnMessages", true) == true)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "editedAt"])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.editedAt == request.time;
        allow delete: if channelRead(server(), resource.data.channel)
          && ((resource.data.senderId == request.auth.uid && (owner(server()) || roleConfig(server()).get("deleteOwnMessages", true) == true)) || moderator(server()));
      }
    }

    match /voiceCalls/{callId} {
      function conversation(d) {
        return d.kind == 'dm'
          ? get(/databases/$(database)/documents/friendships/$(d.conversationId)).data
          : get(/databases/$(database)/documents/groupChats/$(d.conversationId)).data;
      }
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind','conversationId','creatorUid','members','accepted','declined','status','createdAt','expiresAt','ringUntil'])
        && request.resource.data.kind in ['dm','group']
        && request.resource.data.conversationId is string
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 8
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members == conversation(request.resource.data).members
        && request.resource.data.accepted == [request.auth.uid]
        && request.resource.data.declined == []
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt >= request.time - duration.value(1,'m')
        && request.resource.data.createdAt <= request.time + duration.value(1,'m')
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(121,'m')
        && request.resource.data.ringUntil is timestamp
        && request.resource.data.ringUntil > request.time
        && request.resource.data.ringUntil <= request.time + duration.value(2,'m');
      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        (resource.data.creatorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'ended')
        || (resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted'])
          && request.time < resource.data.ringUntil
          && !(request.auth.uid in resource.data.declined)
          && request.resource.data.accepted.hasAll(resource.data.accepted)
          && request.resource.data.accepted.hasOnly(resource.data.accepted.concat([request.auth.uid]))
          && request.auth.uid in request.resource.data.accepted)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declined'])
          && request.resource.data.declined.hasAll(resource.data.declined)
          && request.resource.data.declined.hasOnly(resource.data.declined.concat([request.auth.uid]))
          && request.auth.uid in request.resource.data.declined)
      );
    }

    match /blocks/{blockId} {
      // Friend requests check both possible block IDs. Signed-in users must be
      // able to receive a normal "not found" result when neither record exists.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid != request.auth.uid
        && blockId == request.auth.uid + "_" + request.resource.data.blockedUid;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.gamePath == resource.data.gamePath
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
